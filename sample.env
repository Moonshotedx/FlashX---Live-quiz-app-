# =============================================================================
# FlashX — Sample Environment Configuration (Neon Postgres)
# Copy these variables into `.env.local` for local development or Vercel Env Vars
# =============================================================================

# Required: Neon Postgres connection string (pooled `-pooler` or direct URL)
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Required: Secret key (32+ random characters) to sign admin session cookies & presenter links
AUTH_SECRET="replace-with-a-random-32-character-secret"

# Required for `npm run seed` (and first-time admin login bootstrap)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Optional: Public app URL used on QR codes (auto-detected from browser/host if left empty)
NEXT_PUBLIC_APP_URL=""

# Optional: Timezone used for date stamps in CSV/Excel export filenames
EVENT_TIMEZONE="Asia/Kolkata"

