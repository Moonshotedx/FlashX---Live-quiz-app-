NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=          # public URL of the deployed app, used to build the join URL inside the QR code
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional
SEED_EXTRA_ADMINS=            # comma-separated extra admin emails created by the seed script
SEED_EXTRA_PASSWORD=          # initial password for SEED_EXTRA_ADMINS (required if SEED_EXTRA_ADMINS is set)
ADMIN_EMAILS=                 # comma separated allowlist of admin emails (in addition to app_metadata.role = admin)
EVENT_TIMEZONE=Asia/Kolkata   # used for the date in export filenames
JOIN_RATE_LIMIT_PER_MIN=600   # per IP. Campus Wi-Fi often shares ONE public IP, so keep this high.

